+/// Nemotron-H Omni multimodal wrapper: top-level wraps the text LLM in
+/// `llm_config`, and `quantization_config` lives at the wrapper root (not
+/// inside `llm_config`). The dispatcher must lift `llm_config`, hoist the
+/// quantization block in, and set the language-model-nested weight prefixes
+/// (`language_model.backbone` / `language_model.`) so the existing
+/// nemotron_h weight loader resolves the correct safetensors keys.
+#[test]
+fn test_parse_nemotron_h_omni_wrapper() {
+    let json = r#"{
+        "model_type": "NemotronH_Nano_Omni_Reasoning_V3",
+        "architectures": ["NemotronH_Nano_Omni_Reasoning_V3"],
+        "llm_config": {
+            "model_type": "nemotron_h",
+            "hidden_size": 2688,
+            "num_hidden_layers": 52,
+            "num_attention_heads": 32,
+            "num_key_value_heads": 2,
+            "head_dim": 128,
+            "intermediate_size": 1856,
+            "n_routed_experts": 128,
+            "num_experts_per_tok": 6,
+            "moe_intermediate_size": 1856,
+            "moe_shared_expert_intermediate_size": 3712,
+            "vocab_size": 131072,
+            "tie_word_embeddings": false,
+            "hybrid_override_pattern": "MEMEM*EMEMEM*EMEMEM*EMEMEM*EMEMEM*EMEMEMEM*EMEMEMEME",
+            "mamba_num_heads": 64,
+            "mamba_head_dim": 64,
+            "ssm_state_size": 128,
+            "n_groups": 8,
+            "expand": 2,
+            "conv_kernel": 4,
+            "norm_eps": 1e-5,
+            "rope_theta": 10000,
+            "routed_scaling_factor": 2.5
+        },
+        "quantization_config": {
+            "quant_method": "modelopt",
+            "quant_algo": "NVFP4",
+            "exclude_modules": ["lm_head"]
+        }
+    }"#;
+    let cfg = parse_config(json).unwrap();
+    // Inner LLM model_type passes through so factory.rs dispatches to
+    // the existing NemotronHWeightLoader without a new factory arm.
+    assert_eq!(cfg.model_type, "nemotron_h");
+    // Nemotron-H field-name remappings must still apply through the lift.
+    assert_eq!(cfg.hidden_size, 2688);
+    assert_eq!(cfg.num_hidden_layers, 52);
+    assert_eq!(cfg.num_experts, 128);
+    assert_eq!(cfg.shared_expert_intermediate_size, 3712);
+    assert_eq!(cfg.rms_norm_eps, 1e-5);
+    assert_eq!(cfg.linear_conv_kernel_dim, 4);
+    assert_eq!(cfg.layer_types.len(), 52);
+    assert_eq!(cfg.num_ssm_layers(), 23);
+    assert_eq!(cfg.num_moe_layers(), 23);
+    assert_eq!(cfg.num_attention_layers(), 6);
+    // Multimodal-wrapper-specific assertions.
+    assert_eq!(cfg.weight_prefix, "language_model.backbone");
+    assert_eq!(cfg.lm_head_prefix, "language_model.");
+    assert_eq!(cfg.layer_prefix(3), "language_model.backbone.layers.3");
+    assert!(cfg.nested_config);
+    assert!(!cfg.attn_gated);
+    assert!(!cfg.tie_word_embeddings);
+    // Top-level quantization_config must survive the lift — without it,
+    // QuantFormat dispatch silently falls back to BF16 and the model
+    // serves with mismatched weights.
+    let qc = cfg
+        .quantization_config
+        .as_ref()
+        .expect("top-level quantization_config must be hoisted into the lifted llm_config");
+    assert_eq!(qc.quant_method, "modelopt");
+    assert_eq!(qc.quant_algo, "NVFP4");
+}
